unit avocado_avoraiser_api;

{$mode objfpc}{$H+}

{ Built-in Avoroiser / GUI API names for the Avocado compiler.
  Polish alias -> Pascal (English) name + required uses unit.
  Loaded into TAvocadoLanguage so resolution does not depend on
  avoraiser_translate.ini being next to the executable. }

interface

uses
  SysUtils, Classes;

type
  TAvoApiEntry = record
    Avo: string;       // Polish (or alternate) name as written in Avocado
    Pascal: string;    // name emitted in Pascal
    UnitName: string;  // uses unit ('' = none / RTL)
    MinArgs: Integer;
    MaxArgs: Integer;  // -1 = unbounded
  end;

  TAvoApiTable = array of TAvoApiEntry;

function AvoraiserApiTable: TAvoApiTable;

implementation

var
  GTable: TAvoApiTable;
  GBuilt: Boolean;

function Ent(const AAvo, APascal, AUnit: string; AMin, AMax: Integer): TAvoApiEntry;
begin
  Result.Avo := AAvo;
  Result.Pascal := APascal;
  Result.UnitName := AUnit;
  Result.MinArgs := AMin;
  Result.MaxArgs := AMax;
end;

