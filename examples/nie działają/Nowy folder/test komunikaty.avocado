program_ui nnn
import avoraiser.window
uchwyt_okna moje_okno
glowny
  glowna_funkcja
  uruchom_aplikacje()
koniec.
 
procedura glowna_funkcja
poczatek
  parametry_ui ui
  ui = default(TAvocadoWindowParams)
  ui.tytul = 'Okno w Avocado'
  ui.szerokosc = 400
  ui.wysokosc = 600
  ui.x = 200
  ui.y = 200
  ui.widoczne = prawda
  ui.maksymalizacja = prawda
  
  
  //Tworzenie Okna Main
  moje_okno = utworz_okno(ui)
  
  jezeli moje_okno <> 0 wtedy
  poczatek
    wysrodkuj_okno(moje_okno)
    //Kod aplikacji
    show_message(moje_okno, 'Info', 'opis')
  koniec
koniec
