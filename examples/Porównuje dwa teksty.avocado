program testowytest
glowny
siema
koniec.

procedura siema
poczatek
tekst a = 'Siema'
tekst b = 'Hello'
  liczba_całkowita c = porównaj_tekst(a, b)
  pisz_linie(c)
  jezeli c = 0 wtedy
  poczatek
    pisz_linie('Słowa są równe sobie')
  koniec
  jezeli c > 0 wtedy
  poczatek
    pisz_linie(a, ' jest większe od ', b)
  koniec
  jezeli c < 0 wtedy
  poczatek
    pisz_linie(a, ' jest mniejsze od ', b)
  koniec
koniec
