program warunek
początek
 warunek_if_then
koniec.

procedura warunek_if_then
początek
//lokalne zmienne
liczba_całkowita a = 12
real c = 5.5
//kod
jeżeli a > 11 wtedy
początek
  pisz_linie('a>11')
koniec
inaczej
jeżeli a > 10 wtedy
początek
